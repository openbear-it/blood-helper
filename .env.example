# Environment
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Database
POSTGRES_USER=blood-helper
POSTGRES_PASSWORD=blood-helper
POSTGRES_DB=blood-helper
DATABASE_URL=postgresql+asyncpg://blood-helper:blood-helper@db:5432/blood-helper
DATABASE_URL_SYNC=postgresql+psycopg2://blood-helper:blood-helper@db:5432/blood-helper

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
